# Disalin otomatis ke config/server.env saat pertama kali dijalankan.

# Folder penyimpanan cloud (di storage bersama Android; butuh termux-setup-storage)
CLOUD_ROOT="$HOME/storage/shared/CloudStorage"

# Port SSH/SFTP (bawaan Termux: 8022)
SSH_PORT=8022

# ---- Pengawas (watchdog): menjaga server tetap online ----
# Seberapa sering (detik) layanan & internet diperiksa
WD_INTERVAL=60
# Internet dianggap putus jika uji TCP ini gagal (tanpa DNS, tanpa curl)
NET_CHECK_HOST=1.1.1.1
NET_CHECK_PORT=443
# Berapa kali berturut-turut gagal sebelum pemulihan Wi-Fi dicoba
WD_NET_FAILS=3
# 1 = coba matikan-nyalakan Wi-Fi saat internet putus (butuh aplikasi Termux:API;
#     hanya berhasil di sebagian perangkat)
WD_WIFI_RECOVER=1
# Catat peringatan di log jika suhu baterai (derajat C) mencapai angka ini
WD_TEMP_WARN=42
# Log dirotasi saat start jika melebihi ukuran ini (KB)
LOG_MAX_KB=1024
