# Disalin otomatis oleh `cloud init` menjadi config/admin.env

# IP Wi-Fi atau IP Tailscale (100.x.y.z) HP cloud. Lihat: `cloudctl status` di HP cloud.
CLOUD_HOST=192.168.1.50

# Username Termux di HP cloud (jalankan `whoami` di sana, mis. u0_a123)
CLOUD_USER=u0_a123

SSH_PORT=8022
SSH_KEY="$HOME/.ssh/id_ed25519_cloud"

# Folder skrip server di HP cloud, relatif terhadap $HOME Termux
REMOTE_DIR=cloud-server

# Folder penyimpanan di HP cloud (relatif terhadap $HOME Termux).
# Harus sama dengan CLOUD_ROOT di server.env
REMOTE_ROOT=storage/shared/CloudStorage
